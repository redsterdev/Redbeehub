local function getPing()
    local ok,p = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return ok and p or 50
end
local function getAdjustedDelay(base)
    local d = base
    if config.pingCompensate then d = d + (getPing() / 2000) end
    if config.humanJitter then d = d + (math.random() * config.jitterAmount * 2 - config.jitterAmount) end
    return math.max(d, 0.05)
end
local function getChar() return LP.Character end
local function getHRP() local c = getChar() return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum() local c = getChar() return c and c:FindFirstChildOfClass("Humanoid") end
local function findTool(name)
    local c = getChar()
    local bp = LP:FindFirstChild("Backpack")
    if c then local t = c:FindFirstChild(name) if t and t:IsA("Tool") then return t end end
    if bp then local t = bp:FindFirstChild(name) if t and t:IsA("Tool") then return t end end
    return nil
end
local function equipAndReady(toolName)
    local c = getChar() local hum = getHum()
    if not c or not hum then return nil end
    local e = c:FindFirstChild(toolName)
    if e and e:IsA("Tool") then state.currentTool = e return e end
    local t = findTool(toolName)
    if not t then return nil end
    hum:EquipTool(t) state.currentTool = t task.wait(0.15)
    return c:FindFirstChild(toolName) or t
end

-- ============================================
-- THE REAL FIRE METHOD — sends tool + target position
-- ============================================
local function activateTool(tool, targetPos)
    if not tool or not HitRemote then return false end
    local c = getChar() if not c or tool.Parent ~= c then return false end
    local hrp = getHRP() if not hrp then return false end

    targetPos = targetPos or (hrp.Position + hrp.CFrame.LookVector * 20)

    -- Fire the remote with the tool instance + target position
    -- Core bytecode showed: ActivateTool → ToolNetworking.Hit:FireServer(...)
    local sent = false
    sent = pcall(function() HitRemote:FireServer(tool, targetPos) end) or sent
    if not sent then
        pcall(function() HitRemote:FireServer(tool) end)
    end
    return true
end

local function findTarget(mode)
    local hrp = getHRP() if not hrp then return nil end
    local myPos = hrp.Position
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - myPos).Magnitude
                if d >= config.rocketMinDist and d <= config.rocketMaxDist then
                    table.insert(list, {root=r, dist=d, hp=h.Health, y=r.Position.Y})
                end
            end
        end
    end
    if #list == 0 then return nil end
    if mode == "nearest" then table.sort(list, function(a,b) return a.dist < b.dist end)
    elseif mode == "lowest" then table.sort(list, function(a,b) return a.hp < b.hp end)
    elseif mode == "tower" then table.sort(list, function(a,b) return a.y > b.y end)
    elseif mode == "crowd" then
        for _, a in ipairs(list) do
            a.n = 0
            for _, b in ipairs(list) do
                if a ~= b and (a.root.Position - b.root.Position).Magnitude < 15 then a.n = a.n + 1 end
            end
        end
        table.sort(list, function(a,b) return a.n > b.n end)
    end
    return list[1].root
end

local function aimAt(pos, smooth)
    if not config.autoAim then return end
    local cam = workspace.CurrentCamera if not cam then return end
    if not state.originalAim then state.originalAim = cam.CFrame end
    local dir = (pos - cam.CFrame.Position).Unit
    cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, cam.CFrame.Position + dir), smooth or 0.5)
end
local function restoreAim()
    if state.originalAim and workspace.CurrentCamera then workspace.CurrentCamera.CFrame = state.originalAim end
    state.originalAim = nil
end
local function groundDist()
    local hrp = getHRP() if not hrp then return 0 end
    local p = RaycastParams.new() p.FilterDescendantsInstances = {getChar()} p.FilterType = Enum.RaycastFilterType.Exclude
    local r = workspace:Raycast(hrp.Position, Vector3.new(0, -500, 0), p)
    return r and (hrp.Position - r.Position).Magnitude or 999
end
local function isFalling()
    local hrp = getHRP() local hum = getHum() if not hrp or not hum then return false end
    return hrp.AssemblyLinearVelocity.Y < config.fallThreshold and hum.FloorMaterial == Enum.Material.Air
end
local function setJump(s) local h = getHum() if h then h.Jump = s end end

local function fireSSJ()
    local t = equipAndReady("Slingshot") if not t then return end
    local hrp = getHRP() if not hrp then return end
    local aim = hrp.Position - Vector3.new(0, 3, 0) + hrp.CFrame.LookVector * 2
    activateTool(t, aim)
end
local function runSSJ()
    local hrp = getHRP()
    if hrp and config.autoAim then
        aimAt(hrp.Position - Vector3.new(0,3,0) + hrp.CFrame.LookVector * 2, config.aimSmooth)
    end
    if config.autoJump and not state.holdingJump then state.holdingJump = true setJump(true) end
    local now = tick()
    if now - (state.lastClick.ssj or 0) >= getAdjustedDelay(config.clickDelay) then
        state.lastClick.ssj = now fireSSJ()
    end
end

local function fireRocket()
    local t = equipAndReady("Rocket") if not t then return end
    local tgt = findTarget(config.rocketTarget)
    local aim
    if tgt then
        local hrp = getHRP()
        if hrp then
            local d = (tgt.Position - hrp.Position).Magnitude
            local lead = tgt.AssemblyLinearVelocity * (d / 100)
            aim = tgt.Position + lead
            aimAt(aim, 0.7)
        end
    end
    task.wait(0.05)
    activateTool(t, aim)
end
local function placeWall()
    local t = equipAndReady("Trowel") if not t then return end
    local hrp = getHRP() if not hrp then return end
    local pp
    if config.trowelMode == "forward" then pp = hrp.Position + hrp.CFrame.LookVector * 8 - Vector3.new(0,2,0)
    elseif config.trowelMode == "down" then pp = hrp.Position - Vector3.new(0,5,0) + hrp.CFrame.LookVector * 4
    else pp = hrp.Position - hrp.CFrame.LookVector * 8 - Vector3.new(0,2,0) end
    aimAt(pp, 0.6)
    task.wait(0.05)
    activateTool(t, pp)
end
local function findBombSpot()
    if config.bombStrategy == "spot" then return config.bombSpot end
    if config.bombStrategy == "tower" then
        local hi, hy = nil, -math.huge
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Anchored then
                local n = v.Name:lower()
                if not n:find("baseplate") and not n:find("terrain") and not n:find("sky") then
                    if v.Position.Y > hy and v.Size.Magnitude < 100 then hy = v.Position.Y hi = v end
                end
            end
        end
        if hi then return hi.Position + Vector3.new(0,3,0) end
    elseif config.bombStrategy == "crowd" then
        local t = findTarget("crowd") if t then return t.Position end
    elseif config.bombStrategy == "support" then
        local t = findTarget("nearest") if t then return t.Position - Vector3.new(0,4,0) end
    end
    return nil
end
local function placeBomb()
    local t = equipAndReady("Bomb") if not t then return end
    local s = findBombSpot()
    if s then aimAt(s, 0.7) state.bombTargetPos = s end
    task.wait(0.05)
    activateTool(t, s)
end
local function fireBall()
    local t = equipAndReady("Superball") if not t then return end
    local tgt = findTarget(config.ballTarget)
    local aim if tgt then aim = tgt.Position aimAt(aim, 0.6) end
    task.wait(0.03)
    activateTool(t, aim)
end
local function firePaint()
    local t = equipAndReady("PaintballGun") if not t then return end
    local tgt = findTarget(config.paintTarget)
    local aim if tgt then aim = tgt.Position aimAt(aim, 0.4) end
    task.wait(0.03)
    activateTool(t, aim)
end

RunService.RenderStepped:Connect(function()
    if config.ssjEnabled then
        if config.autoFall then
            if isFalling() then
                if groundDist() > config.minHeight then
                    state.fallProtectionActive = true
                    runSSJ()
                end
            elseif state.fallProtectionActive then
                state.fallProtectionActive = false
                state.holdingJump = false
                setJump(false)
                restoreAim()
            end
        end
        if not state.fallProtectionActive then runSSJ() end
    else
        if state.holdingJump then state.holdingJump = false setJump(false) end
        if state.fallProtectionActive then state.fallProtectionActive = false restoreAim() end
    end
    if config.rocketEnabled then
        local now = tick()
        if now - (state.lastClick.rocket or 0) >= getAdjustedDelay(config.rocketDelay) then
            state.lastClick.rocket = now fireRocket()
        end
    end
    if config.trowelEnabled then
        local now = tick()
        if now - (state.lastClick.trowel or 0) >= getAdjustedDelay(config.trowelDelay) then
            state.lastClick.trowel = now placeWall()
        end
    end
    if config.bombEnabled then
        local now = tick()
        if now - (state.lastClick.bomb or 0) >= getAdjustedDelay(config.bombDelay) then
            state.lastClick.bomb = now placeBomb()
        end
    end
    if config.ballEnabled then
        local now = tick()
        if now - (state.lastClick.ball or 0) >= getAdjustedDelay(config.ballDelay) then
            state.lastClick.ball = now fireBall()
        end
    end
    if config.paintEnabled then
        local now = tick()
        if now - (state.lastClick.paint or 0) >= getAdjustedDelay(config.paintDelay) then
            state.lastClick.paint = now firePaint()
        end
    end
end)

